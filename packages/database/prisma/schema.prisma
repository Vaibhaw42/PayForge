// PayForge — Prisma schema
//
// Governance: ADR-0004 (Prisma), ADR-0005 (Postgres 17).
// Domain tables land in their phases:
//   Phase 2: merchants, users, sessions
//   Phase 3: api_keys, webhook_endpoints
//   Phase 4: payment_intents, refunds, disputes
//   Phase 5: accounts, journal_entries, postings
//   Phase 7: webhook_deliveries, dlq_events, inbox_events, outbox_events

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Phase 1 baseline — a single row keeps schema alive and lets the health
/// endpoint verify DB connectivity via SELECT.
model HealthCheck {
  id        Int      @id @default(1)
  name      String   @default("payforge")
  version   String   @default("0.0.0")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("_health")
}
