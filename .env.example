# PayForge — local dev environment
# Copy to .env and adjust as needed. Do NOT commit .env.

# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- Logging ---
LOG_LEVEL=info

# --- Postgres (compose.dev.yml exposes on host:5433 to avoid clash with native pg on 5432) ---
DATABASE_URL=postgres://payforge:payforge_dev_password@localhost:5433/payforge

# --- Redis (compose.dev.yml exposes on host:6379) ---
REDIS_URL=redis://localhost:6379

# --- Kafka (compose.dev.yml exposes EXTERNAL listener on host:9092) ---
KAFKA_BROKERS=localhost:9092

# --- Service identity (for logs, traces, metrics) ---
SERVICE_NAME=payforge-backend
SERVICE_VERSION=0.0.0
